# Copy this file to .env and fill in your tokens
# .env is git-ignored — never commit real secrets

# HuggingFace — get from https://huggingface.co/settings/tokens
HF_TOKEN=

# IBM Quantum — get from https://quantum.ibm.com (free Open Plan)
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=

# Weights & Biases (optional but recommended) — https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=qverify
WANDB_ENTITY=Quantum-Labor
